---
import Layout from "../layouts/Layout.astro";

const testimonials = [
  {
    quote: "After using Vandhara Soil Recharge for one season, I saw a remarkable difference in my paddy crop. The plants were healthier, the soil felt softer, and I saved nearly 35% on my chemical fertilizer bill.",
    name: "Rajesh K.",
    location: "Karnataka",
    crop: "Paddy",
    product: "Soil Recharge",
  },
  {
    quote: "Root Guard saved my tomato crop from wilt. I had lost nearly half my seedlings to root rot in previous seasons. This season, not a single plant was affected. It's now a permanent part of my farming practice.",
    name: "Muthuraman S.",
    location: "Tamil Nadu",
    crop: "Tomato",
    product: "Root Guard",
  },
  {
    quote: "I was skeptical about organic products, but Vandhara Agni proved me wrong. Within a week of spraying, my chilli crop turned dark green and the leaves were visibly thicker. The yield at harvest was 20% higher than last year.",
    name: "Venkatesh P.",
    location: "Andhra Pradesh",
    crop: "Chilli",
    product: "Agni",
  },
];
---

<Layout title="Testimonials — Vandhara Agrotech | Farmer Reviews & Success Stories">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <h1 class="text-3xl sm:text-4xl font-bold text-brand-green mb-4">What Farmers Say</h1>
    <p class="text-lg text-gray-600 mb-10">Hear from farmers who have made the switch to Vandhara Agrotech products.</p>

    <div class="space-y-6">
      {testimonials.map((t) => (
        <div class="bg-white rounded-xl border border-gray-100 p-6 sm:p-8 shadow-sm">
          <svg class="w-8 h-8 text-brand-green-light/30 mb-3" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="text-gray-700 leading-relaxed italic">"{t.quote}"</p>
          <div class="mt-4 flex items-center gap-4">
            <div class="w-10 h-10 rounded-full bg-brand-green flex items-center justify-center text-white font-bold text-sm">
              {t.name.charAt(0)}
            </div>
            <div>
              <p class="font-semibold text-gray-800 text-sm">{t.name}</p>
              <p class="text-xs text-gray-500">{t.location} | {t.crop} farmer | {t.product}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center bg-green-50 rounded-xl p-8">
      <h2 class="text-xl font-bold text-brand-green mb-2">Share Your Story</h2>
      <p class="text-gray-600 text-sm mb-4">Used our products? We'd love to hear from you.</p>
      <a href="/contact" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg btn-cta hover:bg-amber-600 transition-colors text-sm">
        Share Your Feedback
      </a>
    </div>
  </div>
</Layout>
