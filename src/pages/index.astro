---
import Layout from "../layouts/Layout.astro";
import { productList } from "../data/products";

const products = productList.map(({ slug, name, tagline, description, benefit }) => ({
  slug, name, tagline, description, benefit,
}));

const sustainabilityPoints = [
  { icon: "leaf", label: "Rejuvenates Soil Health", desc: "Damaged by Excessive Chemical Use" },
  { icon: "flask", label: "Zero Synthetic Chemicals", desc: "At Any Stage" },
  { icon: "globe", label: "Local Sourcing", desc: "Reduces Carbon Footprint" },
  { icon: "recycle", label: "Upcycled", desc: "All Waste Materials Composted or Upcycled" },
  { icon: "sprout", label: "Organic Farming Principles", desc: "Align with Permaculture & Organic Farming" },
];
---

<Layout title="Vandhara Agrotech — Eco-Friendly Organic Fertilizers | Soil Health Solutions">
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-green via-green-800 to-green-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
      <div class="max-w-3xl">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight">
          Restoring India's
          <span class="text-brand-gold">Soil Health</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-green-100 leading-relaxed max-w-2xl">
          Eco-friendly, scientifically developed fermented organic liquids that blend traditional wisdom with modern microbiology. Empowering farmers to shift from synthetic inputs to regenerative soil nutrition.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/products" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg btn-cta hover:bg-amber-600 transition-colors">
            Explore Products
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href="/partner" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border-2 border-white/30 text-white font-semibold hover:bg-white/10 transition-colors">
            Partner with Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-brand-green">Our Products</h2>
      <p class="mt-3 text-gray-600 text-lg max-w-2xl mx-auto">Scientifically developed fermented organic liquids for every stage of crop growth</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {products.map((p) => (
        <a
          href={`/products/${p.slug}`}
          class="group bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md hover:border-brand-green-light/30 transition-all"
        >
          <h3 class="text-xl font-bold text-brand-green group-hover:text-brand-green-light transition-colors">{p.name}</h3>
          <p class="text-sm font-medium text-brand-gold mt-1">{p.tagline}</p>
          <p class="text-sm text-gray-600 mt-3 leading-relaxed">{p.description}</p>
          <p class="mt-4 text-sm font-semibold text-brand-green-light">{p.benefit}</p>
        </a>
      ))}
    </div>
    <div class="text-center mt-10">
      <a href="/products" class="inline-flex items-center gap-2 text-brand-green font-semibold hover:text-brand-green-light transition-colors">
        View Full Comparison
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-brand-green">Our Commitment to Sustainability</h2>
        <p class="mt-3 text-gray-600 text-lg">Every step of our process is designed with the planet in mind</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
        {sustainabilityPoints.map((s) => (
          <div class="text-center p-4">
            <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-brand-green/10 flex items-center justify-center">
              {s.icon === "leaf" && <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>}
              {s.icon === "flask" && <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
              {s.icon === "globe" && <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
              {s.icon === "recycle" && <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>}
              {s.icon === "sprout" && <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>}
            </div>
            <h3 class="font-semibold text-brand-green text-sm">{s.label}</h3>
            <p class="text-xs text-gray-500 mt-1">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="bg-gradient-to-r from-brand-green to-green-700 rounded-2xl p-8 sm:p-12 text-white text-center">
      <h2 class="text-2xl sm:text-3xl font-bold">Ready to Transform Your Soil?</h2>
      <p class="mt-3 text-green-100 text-lg max-w-xl mx-auto">Get in touch with our team for personalized recommendations and bulk pricing.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="px-6 py-3 rounded-lg btn-cta hover:bg-amber-600 transition-colors">
          Get a Quote
        </a>
        <a href="/products" class="px-6 py-3 rounded-lg border-2 border-white/30 text-white font-semibold hover:bg-white/10 transition-colors">
          View Products
        </a>
      </div>
    </div>
  </section>
</Layout>
