---
import Layout from "../layouts/Layout.astro";
import { productList } from "../data/products";

const products = productList.map(({ slug, name, tagline, description, benefit }) => ({
  slug, name, tagline, description, benefit,
}));

const pillars = [
  {
    icon: "leaf", title: "Rejuvenates Soil Health",
    desc: "Damaged by Excessive Chemical Use",
    detail: "Our products actively restore soil biology and organic matter depleted by decades of chemical farming.",
  },
  {
    icon: "flask", title: "Zero Synthetic Chemicals",
    desc: "At Any Stage",
    detail: "From raw material to finished product, no synthetic chemicals are used at any stage of manufacturing.",
  },
  {
    icon: "globe", title: "Local Sourcing",
    desc: "Reduces Carbon Footprint",
    detail: "We source animal dung, Napier grass, and agro-waste locally, reducing transportation emissions.",
  },
  {
    icon: "recycle", title: "Upcycled",
    desc: "All Waste Materials Composted or Upcycled",
    detail: "Nothing goes to waste — every byproduct of our CBG and composting process is upcycled.",
  },
  {
    icon: "sprout", title: "Organic Farming Principles",
    desc: "Align with Permaculture & Organic Farming",
    detail: "Our practices and products support permaculture and certified organic farming systems.",
  },
];

const testimonials = [
  {
    quote: "After using Vandhara Soil Recharge for one season, I saw a remarkable difference in my paddy crop. The plants were healthier, the soil felt softer, and I saved nearly 35% on my chemical fertilizer bill.",
    name: "Rajesh K.", location: "Karnataka", crop: "Paddy", product: "Soil Recharge",
  },
  {
    quote: "Root Guard saved my tomato crop from wilt. I had lost nearly half my seedlings to root rot in previous seasons. This season, not a single plant was affected.",
    name: "Muthuraman S.", location: "Tamil Nadu", crop: "Tomato", product: "Root Guard",
  },
  {
    quote: "I was skeptical about organic products, but Vandhara Agni proved me wrong. Within a week of spraying, my chilli crop turned dark green and leaves were visibly thicker. Yield was 20% higher.",
    name: "Venkatesh P.", location: "Andhra Pradesh", crop: "Chilli", product: "Agni",
  },
];
---

<Layout title="Vandhara Agrotech — Eco-Friendly Organic Fertilizers | Soil Health Solutions" description="Vandhara Agrotech offers fermented organic liquids — Soil Recharge, Root Guard, Agni & Vaayu — for sustainable soil health. Reduce chemical fertilizers by 30-40%.">
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-green via-green-800 to-brand-green-dark text-white min-h-[90vh] flex items-center">
    <div class="hero-glow-1" aria-hidden="true" />
    <div class="hero-glow-2" aria-hidden="true" />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 relative z-10 w-full">
      <div class="max-w-3xl reveal">
        <p class="text-amber-300 font-semibold text-sm tracking-[0.2em] uppercase mb-5">Fermented Organic Liquids</p>
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold leading-tight">
          Restoring India's<br/>
          <span class="text-amber-400">Soil Health</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-white/75 leading-relaxed max-w-2xl">
          Eco-friendly, scientifically developed fermented organic liquids that blend traditional wisdom with modern microbiology. Empowering farmers to shift from synthetic inputs to regenerative soil nutrition.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/products" class="group inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-amber-500 text-white font-semibold hover:bg-amber-400 transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
            Explore Products
            <svg class="cta-arrow w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href="/partner" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border-2 border-white/30 text-white font-semibold hover:bg-white/10 transition-all hover:-translate-y-0.5">
            Partner with Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-brand-cream border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 text-center">
        <div class="reveal reveal-delay-1">
          <div class="text-3xl lg:text-4xl font-bold text-brand-green"><span data-target="5000">0</span>+</div>
          <div class="text-sm text-gray-500 mt-1">Farmers Served</div>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="text-3xl lg:text-4xl font-bold text-brand-green"><span data-target="4">0</span>+</div>
          <div class="text-sm text-gray-500 mt-1">Indian States</div>
        </div>
        <div class="reveal reveal-delay-3">
          <div class="text-3xl lg:text-4xl font-bold text-brand-green"><span data-target="40">0</span>%</div>
          <div class="text-sm text-gray-500 mt-1">Fertilizer Savings</div>
        </div>
        <div class="reveal">
          <div class="text-3xl lg:text-4xl font-bold text-brand-green">FCO+NPOP</div>
          <div class="text-sm text-gray-500 mt-1">Certified Organic</div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl sm:text-4xl font-bold text-brand-green">Our Products</h2>
      <p class="mt-3 text-gray-600 text-lg max-w-2xl mx-auto">Scientifically developed fermented organic liquids for every stage of crop growth</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {products.map((p, i) => (
        <a
          href={`/products/${p.slug}`}
          class={`group bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:card-lift hover:border-brand-green-light/30 transition-all reveal reveal-delay-${Math.min(i + 1, 3)}`}
        >
          <h3 class="text-xl font-bold text-brand-green group-hover:text-brand-green-light transition-colors">{p.name}</h3>
          <p class="text-sm font-medium text-brand-gold mt-1">{p.tagline}</p>
          <p class="text-sm text-gray-600 mt-3 leading-relaxed">{p.description}</p>
          <p class="mt-4 text-sm font-semibold text-brand-green">{p.benefit}</p>
        </a>
      ))}
    </div>
    <div class="text-center mt-10 reveal">
      <a href="/products" class="inline-flex items-center gap-2 text-brand-green font-semibold hover:text-brand-green transition-colors group">
        View Full Comparison
        <svg class="cta-arrow w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </section>

  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <h2 class="text-3xl sm:text-4xl font-bold text-brand-green">Our Commitment to Sustainability</h2>
        <p class="mt-3 text-gray-600 text-lg">Every step of our process is designed with the planet in mind</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        {pillars.map((p, i) => (
          <div class={`bg-white rounded-xl border border-gray-100 p-6 shadow-sm hover:shadow-md transition-shadow reveal reveal-delay-${Math.min(i + 1, 3)}`}>
            <div class="w-12 h-12 mb-4 rounded-full bg-brand-green/10 flex items-center justify-center">
              {p.icon === "leaf" && <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>}
              {p.icon === "flask" && <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>}
              {p.icon === "globe" && <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
              {p.icon === "recycle" && <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>}
              {p.icon === "sprout" && <svg class="w-6 h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>}
            </div>
            <h3 class="text-xl font-bold text-brand-green">{p.title}</h3>
            <p class="text-sm font-medium text-brand-gold mt-1">{p.desc}</p>
            <p class="text-gray-600 mt-3 text-sm leading-relaxed">{p.detail}</p>
          </div>
        ))}
      </div>
      <div class="bg-green-50 rounded-xl p-6 sm:p-8 mb-6 reveal">
        <h2 class="text-2xl font-bold text-brand-green mb-4">Circular Economy in Action</h2>
        <p class="text-gray-700 leading-relaxed text-sm">
          Our CBG plant is the heart of our circular model. Agro-residue feeds the plant, which generates clean energy and nutrient-rich digestate. That digestate is composted into premium organic liquid fertilizers — completing a cycle where nothing is wasted.
        </p>
        <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
          <div class="bg-white rounded-lg p-4"><div class="text-2xl font-bold text-brand-green">100%</div><div class="text-xs text-gray-500 mt-1">Renewable Inputs</div></div>
          <div class="bg-white rounded-lg p-4"><div class="text-2xl font-bold text-brand-green">Zero</div><div class="text-xs text-gray-500 mt-1">Synthetic Chemicals</div></div>
          <div class="bg-white rounded-lg p-4"><div class="text-2xl font-bold text-brand-green">100%</div><div class="text-xs text-gray-500 mt-1">Waste Upcycled</div></div>
          <div class="bg-white rounded-lg p-4"><div class="text-2xl font-bold text-brand-green">30-40%</div><div class="text-xs text-gray-500 mt-1">Fertilizer Reduction</div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl sm:text-4xl font-bold text-brand-green">What Farmers Say</h2>
      <p class="mt-3 text-gray-600 text-lg">Hear from farmers who have made the switch</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-100 p-6 shadow-sm mb-8 reveal">
      <div class="flex items-center gap-3 justify-center sm:justify-start">
        <div class="flex items-center gap-0.5">
          {[1,2,3,4,5].map(() => (<svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>))}
        </div>
        <span class="text-lg font-bold text-gray-800">5.0</span>
        <span class="text-sm text-gray-400">| {testimonials.length} reviews</span>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((t, i) => (
        <div class={`bg-white rounded-xl border border-gray-100 p-6 shadow-sm hover:card-lift transition-all reveal reveal-delay-${Math.min(i + 1, 3)}`}>
          <div class="flex items-center gap-0.5 mb-3">
            {[1,2,3,4,5].map(() => (<svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>))}
          </div>
          <p class="text-gray-700 text-sm leading-relaxed italic">"{t.quote}"</p>
          <div class="mt-4 flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-brand-green flex items-center justify-center text-white font-bold text-xs shrink-0">{t.name.charAt(0)}</div>
            <div>
              <p class="font-semibold text-gray-800 text-sm">{t.name}</p>
              <p class="text-xs text-gray-500">{t.location} | {t.crop} farmer</p>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-10 text-center bg-green-50 rounded-xl p-8 reveal">
      <h2 class="text-xl font-bold text-brand-green mb-2">Share Your Story</h2>
      <p class="text-gray-600 text-sm mb-4">Used our products? We'd love to hear from you.</p>
      <a href="/contact" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg btn-cta hover:bg-amber-600 transition-colors text-sm">Share Your Feedback</a>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="bg-gradient-to-r from-brand-green to-brand-green-dark rounded-2xl p-8 sm:p-12 text-white text-center reveal">
      <h2 class="text-2xl sm:text-3xl font-bold">Ready to Transform Your Soil?</h2>
      <p class="mt-3 text-green-200 text-lg max-w-xl mx-auto">Get in touch with our team for personalized recommendations and bulk pricing.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="px-6 py-3 rounded-lg btn-cta hover:bg-amber-600 transition-all hover:-translate-y-0.5">Get a Quote</a>
        <a href="/products" class="px-6 py-3 rounded-lg border-2 border-white/30 text-white font-semibold hover:bg-white/10 transition-all hover:-translate-y-0.5">View Products</a>
      </div>
    </div>
  </section>
</Layout>
