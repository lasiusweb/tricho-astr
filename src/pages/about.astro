---
import Layout from "../layouts/Layout.astro";

const processSteps = [
  { title: "Agro-residue", description: "Turning waste into worth — we collect animal dung, Napier grass, and agro-waste to begin the cycle of sustainable farming." },
  { title: "CBG Plant", description: "The heart of our operation — our Compressed Bio-Gas plant extracts clean energy while preparing organic digestate for further transformation." },
  { title: "Post CBG Digestate", description: "The nutrient-rich byproduct of CBG processing — where waste begins its journey into becoming premium organic liquid." },
  { title: "Windrow Composting", description: "Layer by layer, we stack and cure the digestate under controlled conditions to boost microbial activity and organic value." },
  { title: "Sieving & Packaging", description: "Sorted, screened, and packed with care — every bottle is uniform, user-friendly, and sealed for freshness." },
  { title: "Storage & Marketing", description: "From warehouse to your backyard — we store responsibly and deliver through trusted retail and online channels." },
];
---

<Layout title="About Us — Vandhara Agrotech | Organic Fertilizer Manufacturer" description="Learn how Vandhara Agrotech creates fermented organic liquids from CBG plant digestate. FCO & NPOP certified organic fertilizers manufactured in Morbi, Gujarat.">
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-green via-green-800 to-brand-green-dark text-white">
    <div class="hero-glow-1" aria-hidden="true" />
    <div class="hero-glow-2" aria-hidden="true" />
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 relative z-10">
      <div class="reveal">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">About Vandhara Agrotech</h1>
        <p class="mt-4 text-lg text-white/75 leading-relaxed max-w-2xl">Restoring India's soil health through eco-friendly, scientifically developed fermented organic liquids.</p>
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 relative z-20 mb-12">
    <div class="bg-white rounded-xl border border-gray-100 p-8 shadow-sm reveal">
      <div class="prose prose-green max-w-none">
        <p class="text-lg text-gray-700 leading-relaxed">
          <strong>Vandhara Agrotech</strong> was founded with a vision to restore India's soil health by offering eco-friendly, scientifically developed alternatives to chemical fertilizers.
        </p>
        <p class="text-gray-700 leading-relaxed mt-4">
          Created by a team of agriculture and sustainability experts, our products blend traditional organic fermented liquid wisdom with modern microbiological techniques to produce carbon-rich, fermented organic liquids. Our mission is to empower farmers and gardeners of all scales to shift from synthetic inputs to sustainable, regenerative soil nutrition.
        </p>
      </div>
    </div>

    <section class="mb-12 reveal">
      <h2 class="text-2xl font-bold text-brand-green mb-6 text-center">Our Mission, Vision &amp; Values</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white rounded-xl border border-gray-100 p-6 shadow-sm">
          <div class="w-10 h-10 rounded-full bg-brand-green/10 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="font-bold text-brand-green">Mission</h3>
          <p class="text-sm text-gray-600 mt-2 leading-relaxed">Restore India's soil health by providing eco-friendly, scientifically developed fermented organic liquids that empower farmers to transition from synthetic inputs to regenerative, sustainable soil nutrition.</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 p-6 shadow-sm">
          <div class="w-10 h-10 rounded-full bg-brand-green/10 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
          </div>
          <h3 class="font-bold text-brand-green">Vision</h3>
          <p class="text-sm text-gray-600 mt-2 leading-relaxed">A future where every Indian farmer has access to affordable, effective organic inputs — creating healthier soils, thriving farms, and a food system that works in harmony with nature.</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 p-6 shadow-sm">
          <div class="w-10 h-10 rounded-full bg-brand-green/10 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
          </div>
          <h3 class="font-bold text-brand-green">Values</h3>
          <p class="text-sm text-gray-600 mt-2 leading-relaxed">Sustainability, innovation rooted in tradition, farmer-first approach, zero-waste manufacturing, and full transparency in everything we do — from the CBG plant to the farmer's field.</p>
        </div>
      </div>
    </section>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-12">
      <div class="bg-white rounded-xl border border-gray-100 p-5 text-center shadow-sm reveal reveal-delay-1">
        <div class="text-3xl font-bold text-brand-green">4</div>
        <div class="text-sm text-gray-500 mt-1">Products</div>
      </div>
      <div class="bg-white rounded-xl border border-gray-100 p-5 text-center shadow-sm reveal reveal-delay-2">
        <div class="text-3xl font-bold text-brand-green"><span data-target="5000">0</span>+</div>
        <div class="text-sm text-gray-500 mt-1">Farmers Served</div>
      </div>
      <div class="bg-white rounded-xl border border-gray-100 p-5 text-center shadow-sm reveal reveal-delay-3">
        <div class="text-3xl font-bold text-brand-green"><span data-target="4">0</span>+</div>
        <div class="text-sm text-gray-500 mt-1">Indian States</div>
      </div>
      <div class="bg-white rounded-xl border border-gray-100 p-5 text-center shadow-sm reveal reveal-delay-3">
        <div class="text-3xl font-bold text-brand-green">FCO+NPOP</div>
        <div class="text-sm text-gray-500 mt-1">Certified</div>
      </div>
    </div>

    <section class="mb-12 reveal">
      <h2 class="text-2xl font-bold text-brand-green mb-8">Our Manufacturing Process</h2>
      <div class="space-y-6">
        {processSteps.map((step, i) => (
          <div class="flex gap-4 sm:gap-6">
            <div class="flex flex-col items-center">
              <div class="flex items-center justify-center w-10 h-10 rounded-full bg-brand-green text-white font-bold shrink-0">
                {i + 1}
              </div>
              {i < processSteps.length - 1 && <div class="w-0.5 flex-1 bg-green-200 mt-2" />}
            </div>
            <div class="pb-6">
              <h3 class="text-xl font-bold text-brand-green">{step.title}</h3>
              <p class="text-gray-600 mt-1 leading-relaxed">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12 reveal">
      <h2 class="text-2xl font-bold text-brand-green mb-6 text-center">Why Choose Vandhara</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="flex gap-4 bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <div class="w-10 h-10 shrink-0 rounded-full bg-amber-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <div>
            <h3 class="font-semibold text-brand-green">FCO &amp; NPOP Certified</h3>
            <p class="text-sm text-gray-600 mt-1">Full regulatory compliance — sell and use with confidence across India.</p>
          </div>
        </div>
        <div class="flex gap-4 bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <div class="w-10 h-10 shrink-0 rounded-full bg-amber-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
          </div>
          <div>
            <h3 class="font-semibold text-brand-green">Made from CBG Plant Digestate</h3>
            <p class="text-sm text-gray-600 mt-1">Our products begin as nutrient-rich digestate from our own Compressed Bio-Gas plant — a true circular economy model.</p>
          </div>
        </div>
        <div class="flex gap-4 bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <div class="w-10 h-10 shrink-0 rounded-full bg-amber-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
          </div>
          <div>
            <h3 class="font-semibold text-brand-green">30-40% Chemical Reduction</h3>
            <p class="text-sm text-gray-600 mt-1">Proven results — farmers using Vandhara products consistently reduce synthetic fertilizer use by 30-40% without yield loss.</p>
          </div>
        </div>
        <div class="flex gap-4 bg-white rounded-xl border border-gray-100 p-5 shadow-sm">
          <div class="w-10 h-10 shrink-0 rounded-full bg-amber-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
          </div>
          <div>
            <h3 class="font-semibold text-brand-green">Zero-Waste Manufacturing</h3>
            <p class="text-sm text-gray-600 mt-1">Every byproduct of our process is composted or upcycled — nothing goes to waste, from biogas energy to organic digestate.</p>
          </div>
        </div>
        <div class="flex gap-4 bg-white rounded-xl border border-gray-100 p-5 shadow-sm sm:col-span-2">
          <div class="w-10 h-10 shrink-0 rounded-full bg-amber-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <div>
            <h3 class="font-semibold text-brand-green">Pan-India Reach</h3>
            <p class="text-sm text-gray-600 mt-1">Serving 5000+ farmers across 4+ states with a growing distribution network. Actively expanding into Karnataka, Tamil Nadu, Andhra, Telangana, and Kerala.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-green-50 rounded-xl p-6 sm:p-8 reveal">
      <h2 class="text-2xl font-bold text-brand-green mb-4">Manufacturing & Marketing</h2>
      <p class="text-gray-700">Manufactured and Marketed by:</p>
      <p class="text-lg font-semibold text-brand-green mt-1">Lasius International Private Limited</p>
      <div class="mt-4 text-sm text-gray-600">
        <p>First Floor, Shop No-4, Real Plaza -2, 8A National Highway,</p>
        <p>Lalpar, Morbi, Gujarat - 363642</p>
        <p class="mt-2"><a href="mailto:vandharaagrotech@gmail.com" class="text-brand-green hover:text-brand-green-light">vandharaagrotech@gmail.com</a></p>
        <p>+91 63592 99124</p>
      </div>
    </section>

    <div class="mt-8 reveal">
      <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg btn-cta hover:bg-amber-600 transition-colors">
        Get in Touch
      </a>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Vandhara Agrotech",
      "description": "Eco-friendly, scientifically developed fermented organic liquids for sustainable soil health",
      "url": "https://vandharaagrotech.com",
      "email": "vandharaagrotech@gmail.com",
      "telephone": "+91-6359299124",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "First Floor, Shop No-4, Real Plaza -2, 8A National Highway, Lalpar",
        "addressLocality": "Morbi",
        "addressRegion": "Gujarat",
        "postalCode": "363642",
        "addressCountry": "IN"
      },
      "founder": { "@type": "Organization", "name": "Lasius International Private Limited" }
    })} />
  </div>
</Layout>
