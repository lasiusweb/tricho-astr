---
import Layout from "../layouts/Layout.astro";
import BrochureButton from "../components/BrochureButton.astro";

const audiences = [
  { title: "Wholesalers", desc: "Bulk distribution partnerships with competitive pricing and dedicated support." },
  { title: "Dealers & Retailers", desc: "Stock Vandhara products at your agri-input store with marketing collateral and training." },
  { title: "FPOs / Farmer Producer Organizations", desc: "Special FPO pricing and training programmes for member farmers." },
  { title: "Distributors", desc: "Exclusive territory distribution opportunities with sales support." },
  { title: "Pesticide & Fertilizer Shops", desc: "Add organic product lines to your existing portfolio and meet growing farmer demand." },
];

const benefits = [
  { icon: "trending", title: "Growing Market", desc: "Organic input market in India is growing at 20%+ annually. Be part of the shift." },
  { icon: "factory", title: "Direct from Manufacturer", desc: "Manufactured by Lasius International Private Limited — no middlemen, better margins." },
  { icon: "package", title: "Convenient Pack Size", desc: "Ready-to-sell 5 Litre packs that suit every customer segment." },
  { icon: "cap", title: "Training & Support", desc: "Product training, farmer demo support, and marketing materials provided." },
  { icon: "globe", title: "Expanding to South India", desc: "Active recruitment in Karnataka, Tamil Nadu, Andhra, Telangana, Kerala." },
  { icon: "check", title: "FCO & NPOP Certified", desc: "Full regulatory compliance. Sell with confidence." },
];
---

<Layout title="Partner with Us — Vandhara Agrotech | Distributor & Dealer Opportunities" description="Become a Vandhara Agrotech dealer or distributor. Exclusive territories, training support, and FCO/NPOP certified organic products. Expanding across South India.">
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-green via-green-800 to-brand-green-dark text-white">
    <div class="hero-glow-1" aria-hidden="true" />
    <div class="hero-glow-2" aria-hidden="true" />
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 relative z-10">
      <div class="reveal">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">Partner with Vandhara Agrotech</h1>
        <p class="mt-4 text-lg text-white/75 leading-relaxed max-w-2xl">We're building a strong distribution network across India. Whether you're a wholesaler, dealer, FPO, or distributor — let's grow together.</p>
      </div>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 relative z-20 mb-12">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-12">
      <div class="bg-white rounded-xl border border-gray-100 p-5 text-center shadow-sm reveal reveal-delay-1">
        <div class="text-3xl font-bold text-brand-green"><span data-target="20">0</span>%+</div>
        <div class="text-sm text-gray-500 mt-1">Market Growth</div>
      </div>
      <div class="bg-white rounded-xl border border-gray-100 p-5 text-center shadow-sm reveal reveal-delay-2">
        <div class="text-3xl font-bold text-brand-green"><span data-target="5000">0</span>+</div>
        <div class="text-sm text-gray-500 mt-1">Farmers Reached</div>
      </div>
      <div class="bg-white rounded-xl border border-gray-100 p-5 text-center shadow-sm reveal reveal-delay-3">
        <div class="text-3xl font-bold text-brand-green"><span data-target="4">0</span></div>
        <div class="text-sm text-gray-500 mt-1">Products</div>
      </div>
      <div class="bg-white rounded-xl border border-gray-100 p-5 text-center shadow-sm reveal reveal-delay-3">
        <div class="text-3xl font-bold text-brand-green"><span data-target="5">0</span></div>
        <div class="text-sm text-gray-500 mt-1">States Expanding</div>
      </div>
    </div>

    <section class="mb-12 reveal">
      <h2 class="text-2xl font-bold text-brand-green mb-6">Who We Work With</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {audiences.map((a) => (
          <div class="bg-white rounded-xl border border-gray-100 p-5 shadow-sm hover:card-lift transition-all">
            <h3 class="font-bold text-brand-green">{a.title}</h3>
            <p class="text-sm text-gray-600 mt-2 leading-relaxed">{a.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12 reveal">
      <h2 class="text-2xl font-bold text-brand-green mb-6">Why Partner with Us</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
{benefits.map((b) => (
  <div class="flex gap-4">
    <div class="w-10 h-10 shrink-0 rounded-full bg-brand-green/10 flex items-center justify-center">
      {b.icon === "trending" && <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>}
      {b.icon === "factory" && <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>}
      {b.icon === "package" && <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>}
      {b.icon === "cap" && <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" /></svg>}
      {b.icon === "globe" && <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
      {b.icon === "check" && <svg class="w-5 h-5 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>}
    </div>
    <div>
      <h3 class="font-semibold text-brand-green">{b.title}</h3>
      <p class="text-sm text-gray-600 mt-1">{b.desc}</p>
    </div>
  </div>
))}
      </div>
    </section>

    <section class="bg-green-50 rounded-xl p-6 sm:p-8 mb-12 reveal">
      <h2 class="text-2xl font-bold text-brand-green mb-4">Our Product Range for Partners</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[600px]">
          <thead>
            <tr class="bg-brand-green text-white">
              <th class="text-left p-3 font-semibold sticky top-0 bg-brand-green z-10">Product</th>
              <th class="text-left p-3 font-semibold sticky top-0 bg-brand-green z-10">Category</th>
              <th class="text-left p-3 font-semibold sticky top-0 bg-brand-green z-10">Pack Sizes</th>
              <th class="text-left p-3 font-semibold sticky top-0 bg-brand-green z-10">Target Audience</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-white hover:bg-green-50 transition-colors">
              <td class="p-3 font-semibold text-brand-green">Soil Recharge</td>
              <td class="p-3 text-gray-600">Liquid Organic Manure</td>
              <td class="p-3 text-gray-600">5L</td>
              <td class="p-3 text-gray-600">All farmers</td>
            </tr>
            <tr class="bg-gray-50 hover:bg-green-50 transition-colors">
              <td class="p-3 font-semibold text-brand-green">Root Guard</td>
              <td class="p-3 text-gray-600">Root Protectant</td>
              <td class="p-3 text-gray-600">5L</td>
              <td class="p-3 text-gray-600">High-value crop growers</td>
            </tr>
            <tr class="bg-white hover:bg-green-50 transition-colors">
              <td class="p-3 font-semibold text-brand-green">Agni</td>
              <td class="p-3 text-gray-600">Growth Regulator</td>
              <td class="p-3 text-gray-600">5L</td>
              <td class="p-3 text-gray-600">Paddy, vegetable growers</td>
            </tr>
            <tr class="bg-gray-50 hover:bg-green-50 transition-colors">
              <td class="p-3 font-semibold text-brand-green">Vaayu</td>
              <td class="p-3 text-gray-600">Pest Repellent</td>
              <td class="p-3 text-gray-600">5L</td>
              <td class="p-3 text-gray-600">Paddy, cotton growers</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="flex flex-wrap gap-4 reveal">
      <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg btn-cta hover:bg-amber-600 transition-colors">
        Become a Partner
      </a>
      <BrochureButton label="Download Partner Brochure" />
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Vandhara Agrotech Partner Program",
      "description": "Distribution and dealer partnership opportunities for organic agricultural inputs across India",
      "brand": { "@type": "Brand", "name": "Vandhara Agrotech" },
      "offers": { "@type": "Offer", "availability": "https://schema.org/InStock" }
    })} />
  </div>
</Layout>
