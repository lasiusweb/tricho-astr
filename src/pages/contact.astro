---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact Us — Vandhara Agrotech | Get a Quote">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <h1 class="text-3xl sm:text-4xl font-bold text-brand-green mb-4">Get a Quote</h1>
    <p class="text-lg text-gray-600 mb-8">Fill in the form below and our team will get back to you within 24 hours.</p>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2 bg-white rounded-xl border border-gray-100 p-6 sm:p-8 shadow-sm">
        <div x-data="{ type: 'farmer' }">
          <div class="flex gap-1 bg-gray-100 rounded-lg p-1 w-fit mb-6" role="tablist" aria-label="Contact type">
            <button
              id="contact-farmer-tab"
              class="px-4 py-2 rounded-md text-sm font-medium transition-colors"
              :class="type === 'farmer' ? 'bg-brand-green text-white shadow-sm' : 'text-gray-600 hover:text-gray-900'"
              @click="type = 'farmer'"
              aria-selected="false" :aria-selected="type === 'farmer' ? 'true' : 'false'"
              tabindex="-1" :tabindex="type === 'farmer' ? 0 : -1"
              role="tab"
              aria-controls="farmer-fields"
            >
              I'm a Farmer
            </button>
            <button
              id="contact-dealer-tab"
              class="px-4 py-2 rounded-md text-sm font-medium transition-colors"
              :class="type === 'dealer' ? 'bg-brand-green text-white shadow-sm' : 'text-gray-600 hover:text-gray-900'"
              @click="type = 'dealer'"
              aria-selected="false" :aria-selected="type === 'dealer' ? 'true' : 'false'"
              tabindex="-1" :tabindex="type === 'dealer' ? 0 : -1"
              role="tab"
              aria-controls="dealer-fields"
            >
              I'm a Dealer / Distributor
            </button>
          </div>

          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-4"
          >
            <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
            <input type="hidden" name="subject" x-bind:value="'Vandhara Quote - ' + type" />
            <input type="hidden" name="from_name" value="Vandhara Agrotech Website" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
                <input type="text" id="name" name="name" autocomplete="name" required class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number *</label>
                <input type="tel" id="phone" name="phone" autocomplete="tel" required class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
              <input type="email" id="email" name="email" autocomplete="email" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
            </div>

            <div>
              <label for="product" class="block text-sm font-medium text-gray-700 mb-1">Product Interest *</label>
              <select id="product" name="product" required class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm bg-white">
                <option value="">Select a product...</option>
                <option value="Soil Recharge">Soil Recharge — Beneficial Microbes Consortia</option>
                <option value="Root Guard">Root Guard — Root Disease Shield</option>
                <option value="Agni">Agni — Growth Accelerator</option>
                <option value="Vaayu">Vaayu — Nature's Pest Defence</option>
                <option value="Multiple">Multiple / Full Range</option>
              </select>
            </div>

            <div id="farmer-fields" role="tabpanel" aria-labelledby="contact-farmer-tab" tabindex="0" x-show="type === 'farmer'" x-cloak>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="crop" class="block text-sm font-medium text-gray-700 mb-1">Crop Type</label>
                  <input type="text" id="crop" name="crop" placeholder="e.g., Paddy, Tomato, Chilli" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
                </div>
                <div>
                  <label for="land" class="block text-sm font-medium text-gray-700 mb-1">Land Area (Acres)</label>
                  <input type="number" id="land" name="land_area" min="0" step="0.5" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
                </div>
              </div>
              <div class="mt-4">
                <label for="current_fertilizer" class="block text-sm font-medium text-gray-700 mb-1">Current Fertilizer / Pesticide Used</label>
                <input type="text" id="current_fertilizer" name="current_fertilizer" placeholder="e.g., Urea, DAP, Chemical pesticides" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
              </div>
            </div>

            <div id="dealer-fields" role="tabpanel" aria-labelledby="contact-dealer-tab" tabindex="0" x-show="type === 'dealer'" x-cloak>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="shop" class="block text-sm font-medium text-gray-700 mb-1">Shop / Business Name *</label>
                  <input type="text" id="shop" name="shop_name" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
                </div>
                <div>
                  <label for="gst" class="block text-sm font-medium text-gray-700 mb-1">GST Number</label>
                  <input type="text" id="gst" name="gst" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
                <div>
                  <label for="village" class="block text-sm font-medium text-gray-700 mb-1">Village / Town *</label>
                  <input type="text" id="village" name="village" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
                </div>
                <div>
                  <label for="mandal" class="block text-sm font-medium text-gray-700 mb-1">Mandal / Tehsil *</label>
                  <input type="text" id="mandal" name="mandal" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
                </div>
                <div>
                  <label for="district" class="block text-sm font-medium text-gray-700 mb-1">District *</label>
                  <input type="text" id="district" name="district" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                <div>
                  <label for="state" class="block text-sm font-medium text-gray-700 mb-1">State *</label>
                  <input type="text" id="state" name="state" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
                </div>
                <div>
                  <label for="pincode" class="block text-sm font-medium text-gray-700 mb-1">Pincode *</label>
                  <input type="text" id="pincode" name="pincode" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm" />
                </div>
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell us about your requirements..." class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-green focus:border-brand-green outline-none transition-colors text-sm resize-y"></textarea>
            </div>

            <button type="submit" class="w-full px-6 py-3 rounded-lg btn-cta hover:bg-amber-600 transition-colors text-sm">
              Submit Enquiry
            </button>
          </form>
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-white rounded-xl border border-gray-100 p-6 shadow-sm">
          <h2 class="font-bold text-brand-green mb-3">Contact Information</h2>
          <ul class="space-y-3 text-sm text-gray-600">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-green shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              <a href="mailto:vandharaagrotech@gmail.com" class="hover:text-brand-green">vandharaagrotech@gmail.com</a>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-green shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              <span>+91 63592 99124</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-green shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span>First Floor, Shop No-4, Real Plaza -2,<br />8A National Highway, Lalpar,<br />Morbi, Gujarat - 363642</span>
            </li>
          </ul>
        </div>

        <div class="bg-green-50 rounded-xl p-6">
          <h2 class="font-bold text-brand-green mb-2">Manufactured by</h2>
          <p class="text-sm text-gray-600 font-medium">UMA Enterprises</p>
          <p class="text-xs text-gray-500 mt-1">FCO &amp; NPOP certified</p>
        </div>

        <div class="bg-white rounded-xl border border-gray-100 p-6 shadow-sm">
          <h2 class="font-bold text-brand-green mb-3">Targeting South India</h2>
          <p class="text-sm text-gray-600">We are actively expanding our dealer and distributor network across Karnataka, Tamil Nadu, Andhra Pradesh, Telangana, and Kerala.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
