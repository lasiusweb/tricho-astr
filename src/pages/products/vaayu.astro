---
import Layout from "../../layouts/Layout.astro";
import B2BToggle from "../../components/B2BToggle.astro";
import BrochureButton from "../../components/BrochureButton.astro";
import ProductVariantGallery from "../../components/ProductVariantGallery.astro";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";
import { productList } from "../../data/products";

const product = productList.find((p) => p.slug === "vaayu")!;
---

<Layout title="Vandhara Vaayu — Nature's Pest Defence | Organic Pest Repellent">
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <div class="mb-8">
      <a href="/products" class="text-sm text-brand-green font-medium hover:text-brand-green-light transition-colors">&larr; All Products</a>
    </div>

    <div class="bg-gradient-to-r from-brand-green to-green-700 rounded-2xl p-8 sm:p-12 text-white mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold">{product.nameUpper}</h1>
      <p class="text-brand-gold-light font-semibold mt-2 text-lg">{product.tagline}</p>
      <p class="mt-4 text-green-100 text-lg leading-relaxed max-w-2xl">{product.description}</p>
      <p class="mt-2 text-green-100 font-medium">Best for: {product.bestFor}</p>
    </div>

    <ProductVariantGallery variants={product.variants} productName={product.name} />

    <B2BToggle>
      <div slot="farmer">
        <section class="mb-10">
          <h2 class="text-2xl font-bold text-brand-green mb-4">Benefits</h2>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-brand-green-light mt-1 shrink-0">&#10003;</span>
              <span>Restricts pests in 1st and 2nd stage of development in all crops</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-green-light mt-1 shrink-0">&#10003;</span>
              <span>Safe for crops, farmers, and the environment</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-green-light mt-1 shrink-0">&#10003;</span>
              <span>Ideal for Integrated Pest Management (IPM) programmes</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-green-light mt-1 shrink-0">&#10003;</span>
              <span>Zero synthetic chemicals at any stage</span>
            </li>
          </ul>
        </section>

        <section class="mb-10">
          <h2 class="text-2xl font-bold text-brand-green mb-4">Method of Application &amp; Dosage</h2>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Foliar Spray:</strong> 3-5 Litres per acre (in 150-200 L water)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Soil Drench:</strong> 3-5 Litres per acre (in 200 L water)</span>
            </li>
          </ul>
        </section>

        <section class="mb-10 bg-green-50 rounded-xl p-6">
          <h2 class="text-xl font-bold text-brand-green mb-4">Schedule &amp; Timing</h2>
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white rounded-lg p-4">
              <dt class="text-sm text-gray-500">Time of Application</dt>
              <dd class="text-sm font-medium text-gray-800">Early morning (6-9 AM) &ndash; when humidity is high</dd>
              <dd class="text-xs text-gray-500 mt-1">Avoid spraying when temperature &gt;35&deg;C or rain expected within 6 hrs</dd>
            </div>
            <div class="bg-white rounded-lg p-4">
              <dt class="text-sm text-gray-500">Interval</dt>
              <dd class="text-sm font-medium text-gray-800">First spray at pest sighting &rarr; repeat after 15 days if needed</dd>
              <dd class="text-xs text-gray-500 mt-1">Max 3 sprays per crop season</dd>
            </div>
            <div class="bg-white rounded-lg p-4 sm:col-span-2">
              <dt class="text-sm text-gray-500">Recommended Crops &amp; Target Pests</dt>
              <dd class="text-sm font-medium text-gray-800">All Horticulture &amp; Agriculture Crops</dd>
            </div>
          </dl>
        </section>

        <section class="mb-10">
          <h2 class="text-xl font-bold text-brand-green mb-4">How to Apply (4 Simple Steps)</h2>
          <ol class="space-y-4">
            <li class="flex items-start gap-4">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-white font-bold text-sm shrink-0">1</span>
              <span>Fill sprayer with half water</span>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-white font-bold text-sm shrink-0">2</span>
              <span>Add 2-3 litres Vandhara Vaayu (for 200 L sprayer)</span>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-white font-bold text-sm shrink-0">3</span>
              <span>Fill remaining water &amp; shake gently</span>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-white font-bold text-sm shrink-0">4</span>
              <span>Spray thoroughly on leaves (underside too) OR drench soil</span>
            </li>
          </ol>
        </section>
      </div>

      <div slot="dealer">
        <section class="mb-10">
          <h2 class="text-2xl font-bold text-brand-green mb-4">Dealer / Distributor Information</h2>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Product:</strong> {product.nameUpper} &mdash; {product.tagline}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Category:</strong> Organic Pest Repellent</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Packaging:</strong> 5L, 20L, 50L</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Regulatory Compliance:</strong> FCO &amp; NPOP certified</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>High demand in:</strong> Paddy, cotton, vegetable growing regions</span>
            </li>
          </ul>
          <div class="mt-6">
            <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg btn-cta hover:bg-amber-600 transition-colors">
              Get Bulk Pricing
            </a>
          </div>
        </section>
      </div>
    </B2BToggle>

    <div class="flex flex-wrap gap-4 mt-8">
      <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg btn-cta hover:bg-amber-600 transition-colors">
        Get a Quote
      </a>
      <BrochureButton />
    </div>

    <YouTubeEmbed youtubeUrl={product.youtubeUrl} productName={product.name} />

    <section class="mt-12 border-t border-gray-200 pt-8">
      <h2 class="text-xl font-bold text-brand-green mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="bg-white rounded-lg border border-gray-200 p-4">
          <summary class="font-semibold text-gray-800 cursor-pointer">What pests does Vaayu control?</summary>
          <p class="mt-2 text-sm text-gray-600">Vandhara Vaayu restricts pests in the 1st and 2nd stages of development across all crops. It is most effective as part of an Integrated Pest Management (IPM) programme.</p>
        </details>
        <details class="bg-white rounded-lg border border-gray-200 p-4">
          <summary class="font-semibold text-gray-800 cursor-pointer">Is Vaayu safe for beneficial insects?</summary>
          <p class="mt-2 text-sm text-gray-600">Yes. As an organic formulation with zero synthetic chemicals, it is safer for beneficial insects, crops, and farmers compared to chemical pesticides when used as directed.</p>
        </details>
        <details class="bg-white rounded-lg border border-gray-200 p-4">
          <summary class="font-semibold text-gray-800 cursor-pointer">How many sprays are needed per season?</summary>
          <p class="mt-2 text-sm text-gray-600">First spray at pest sighting, repeat after 15 days if needed. Maximum 3 sprays per crop season.</p>
        </details>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Vandhara Vaayu",
      "description": "Nature's Pest Defence — organic pest repellent for Integrated Pest Management in all crops",
      "brand": { "@type": "Brand", "name": "Vandhara Agrotech" },
      "manufacturer": { "@type": "Organization", "name": "UMA Enterprises" },
      "category": "Organic Pest Repellent",
      "applicationCategory": "Agriculture",
      "offers": [
        { "@type": "Offer", "name": "5 Litre Pack", "availability": "https://schema.org/InStock" },
        { "@type": "Offer", "name": "20 Litre Pack", "availability": "https://schema.org/InStock" },
        { "@type": "Offer", "name": "50 Litre Pack", "availability": "https://schema.org/InStock" },
      ],
    })} />
  </article>
</Layout>
