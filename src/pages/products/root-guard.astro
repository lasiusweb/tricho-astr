---
import Layout from "../../layouts/Layout.astro";
import B2BToggle from "../../components/B2BToggle.astro";
import BrochureButton from "../../components/BrochureButton.astro";
import ProductVariantGallery from "../../components/ProductVariantGallery.astro";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";
import { productList } from "../../data/products";

const product = productList.find((p) => p.slug === "root-guard")!;
---

<Layout title="Vandhara Root Guard — Root Disease Shield | Organic Root Protection">
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <div class="mb-8">
      <a href="/products" class="text-sm text-brand-green font-medium hover:text-brand-green-light transition-colors">&larr; All Products</a>
    </div>

    <div class="bg-gradient-to-r from-brand-green to-green-700 rounded-2xl p-8 sm:p-12 text-white mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold">{product.nameUpper}</h1>
      <p class="text-brand-gold-light font-semibold mt-2 text-lg">{product.tagline}</p>
      <p class="mt-4 text-green-100 text-lg leading-relaxed max-w-2xl">{product.description}</p>
      <p class="mt-2 text-green-100 font-medium">Best for: {product.bestFor}</p>
    </div>

    <ProductVariantGallery variants={product.variants} productName={product.name} />

    <B2BToggle>
      <div slot="farmer">
        <section class="mb-10">
          <h2 class="text-2xl font-bold text-brand-green mb-4">Benefits</h2>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-brand-green-light mt-1 shrink-0">&#10003;</span>
              <span>Prevents root rot fungi <em>(Fusarium, Rhizoctonia)</em></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-green-light mt-1 shrink-0">&#10003;</span>
              <span>Extends root reach 1000x &rarr; unlocks deep phosphorus &amp; water</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-green-light mt-1 shrink-0">&#10003;</span>
              <span>Enhanced drought resilience &amp; plant immunity &rarr; fewer diseases</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-green-light mt-1 shrink-0">&#10003;</span>
              <span>Organic Carbon feeds microbes for long-term soil health</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-green-light mt-1 shrink-0">&#10003;</span>
              <span>Suppresses soil-borne diseases</span>
            </li>
          </ul>
        </section>

        <section class="mb-10">
          <h2 class="text-2xl font-bold text-brand-green mb-4">Method of Application</h2>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Soil Drench:</strong> Mix 3-5 L in 200 L water &rarr; drench near roots</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Fertigation:</strong> Inject through drip irrigation at transplanting</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Seed Treatment:</strong> Mix 100 ml in 1 L water &rarr; dip seeds before sowing</span>
            </li>
          </ul>
        </section>

        <section class="mb-10 bg-green-50 rounded-xl p-6">
          <h2 class="text-xl font-bold text-brand-green mb-4">Dosage &amp; Schedule</h2>
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white rounded-lg p-4">
              <dt class="text-sm text-gray-500">Dosage per Acre</dt>
              <dd class="text-lg font-bold text-brand-green">3-5 Litres (split into 2-3 applications)</dd>
            </div>
            <div class="bg-white rounded-lg p-4">
              <dt class="text-sm text-gray-500">Time of Application</dt>
              <dd class="text-sm font-medium text-gray-800">Best at transplanting/sowing stage</dd>
              <dd class="text-xs text-gray-500 mt-1">Mix with compost/organic manure or apply directly to soil and nurseries</dd>
            </div>
            <div class="bg-white rounded-lg p-4">
              <dt class="text-sm text-gray-500">Interval</dt>
              <dd class="text-sm font-medium text-gray-800">First dose at transplanting &rarr; repeat every 30 days (max 3 doses/season)</dd>
            </div>
            <div class="bg-white rounded-lg p-4">
              <dt class="text-sm text-gray-500">Recommended Crops</dt>
              <dd class="text-sm font-medium text-gray-800">All Horticulture &amp; Agriculture Crops</dd>
            </div>
          </dl>
        </section>

        <section class="mb-10">
          <h2 class="text-xl font-bold text-brand-green mb-4">How to Apply (3 Simple Steps)</h2>
          <ol class="space-y-4">
            <li class="flex items-start gap-4">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-white font-bold text-sm shrink-0">1</span>
              <span>Take 3 litres of Vandhara Root Guard in 150 litre water tank</span>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-white font-bold text-sm shrink-0">2</span>
              <span>Stir gently (do not aerate heavily &ndash; protects microbes)</span>
            </li>
            <li class="flex items-start gap-4">
              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-green text-white font-bold text-sm shrink-0">3</span>
              <span>Drench soil near roots within 2 hours of mixing</span>
            </li>
          </ol>
        </section>
      </div>

      <div slot="dealer">
        <section class="mb-10">
          <h2 class="text-2xl font-bold text-brand-green mb-4">Dealer / Distributor Information</h2>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Product:</strong> {product.nameUpper} &mdash; {product.tagline}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Category:</strong> Liquid Organic Root Protectant &amp; Bio-stimulant</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Packaging:</strong> 5L, 20L, 50L</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>Regulatory Compliance:</strong> FCO &amp; NPOP certified</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-gold font-bold shrink-0">&#8226;</span>
              <span><strong>High demand in:</strong> Tomato, chilli, banana, turmeric growing regions</span>
            </li>
          </ul>
          <div class="mt-6">
            <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-brand-gold text-white font-semibold hover:bg-amber-600 transition-colors">
              Get Bulk Pricing
            </a>
          </div>
        </section>
      </div>
    </B2BToggle>

    <div class="flex flex-wrap gap-4 mt-8">
      <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-brand-gold text-white font-semibold hover:bg-amber-600 transition-colors">
        Get a Quote
      </a>
      <BrochureButton />
    </div>

    <YouTubeEmbed youtubeUrl={product.youtubeUrl} productName={product.name} />

    <section class="mt-12 border-t border-gray-200 pt-8">
      <h2 class="text-xl font-bold text-brand-green mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="bg-white rounded-lg border border-gray-200 p-4">
          <summary class="font-semibold text-gray-800 cursor-pointer">What diseases does Root Guard prevent?</summary>
          <p class="mt-2 text-sm text-gray-600">Root Guard is effective against root rot fungi including Fusarium and Rhizoctonia, and helps suppress other soil-borne diseases.</p>
        </details>
        <details class="bg-white rounded-lg border border-gray-200 p-4">
          <summary class="font-semibold text-gray-800 cursor-pointer">Can I use it as a seed treatment?</summary>
          <p class="mt-2 text-sm text-gray-600">Yes. Mix 100 ml in 1 L of water and dip seeds before sowing for early protection.</p>
        </details>
        <details class="bg-white rounded-lg border border-gray-200 p-4">
          <summary class="font-semibold text-gray-800 cursor-pointer">How often should I apply Root Guard?</summary>
          <p class="mt-2 text-sm text-gray-600">First dose at transplanting, then repeat every 30 days. Maximum 3 doses per crop season.</p>
        </details>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Vandhara Root Guard",
      "description": "Root Disease Shield — prevents root rot fungi, extends root reach, and boosts plant immunity",
      "brand": { "@type": "Brand", "name": "Vandhara Agrotech" },
      "manufacturer": { "@type": "Organization", "name": "UMA Enterprises" },
      "category": "Organic Bio-stimulant",
      "applicationCategory": "Agriculture",
      "offers": [
        { "@type": "Offer", "name": "5 Litre Pack", "availability": "https://schema.org/InStock" },
        { "@type": "Offer", "name": "20 Litre Pack", "availability": "https://schema.org/InStock" },
        { "@type": "Offer", "name": "50 Litre Pack", "availability": "https://schema.org/InStock" },
      ],
    })} />
  </article>
</Layout>
