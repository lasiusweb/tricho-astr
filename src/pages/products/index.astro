---
import Layout from "../../layouts/Layout.astro";
import BrochureButton from "../../components/BrochureButton.astro";
import { productList } from "../../data/products";

const products = productList.map(({ slug, name, tagline, bestFor, benefit, dosage, application }) => ({
  slug, name, tagline, bestFor, keyBenefit: benefit, dosage, application,
}));
---

<Layout title="Our Products — Vandhara Agrotech | Organic Liquid Fertilizers">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <div class="text-center mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-brand-green">Our Products</h1>
      <p class="mt-3 text-gray-600 text-lg max-w-2xl mx-auto">
        Scientifically developed fermented organic liquids for complete crop nutrition and protection
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {products.map((p) => (
        <a
          href={`/products/${p.slug}`}
          class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:shadow-md hover:border-brand-green-light/30 transition-all group"
        >
          <h2 class="text-xl font-bold text-brand-green group-hover:text-brand-green-light transition-colors">{p.name}</h2>
          <p class="text-sm font-medium text-brand-gold mt-1">{p.tagline}</p>
          <p class="text-sm text-gray-500 mt-1"><span class="font-medium">Best for:</span> {p.bestFor}</p>
          <p class="text-sm text-gray-700 mt-3 leading-relaxed">{p.keyBenefit}</p>
          <div class="mt-4 flex flex-wrap gap-4 text-xs text-gray-500">
            <span>Dosage: {p.dosage}</span>
            <span>Method: {p.application}</span>
          </div>
        </a>
      ))}
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-10">
      <div class="p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-brand-green mb-6">Compare All Products</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-brand-green text-white">
                <th class="text-left p-3 font-semibold">Product</th>
                <th class="text-left p-3 font-semibold">Best For</th>
                <th class="text-left p-3 font-semibold">Key Benefit</th>
                <th class="text-left p-3 font-semibold">Dosage / Acre</th>
                <th class="text-left p-3 font-semibold">Application</th>
              </tr>
            </thead>
            <tbody>
              {products.map((p, i) => (
                <tr class={i % 2 === 0 ? "bg-gray-50" : "bg-white"}>
                  <td class="p-3 font-semibold text-brand-green">
                    <a href={`/products/${p.slug}`} class="hover:text-brand-green-light transition-colors">{p.name}</a>
                  </td>
                  <td class="p-3 text-gray-600">{p.bestFor}</td>
                  <td class="p-3 text-gray-700">{p.keyBenefit}</td>
                  <td class="p-3 text-gray-600">{p.dosage}</td>
                  <td class="p-3 text-gray-600">{p.application}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 bg-gradient-to-r from-brand-green to-green-700 rounded-xl p-6 sm:p-8 text-white">
      <div>
        <h3 class="text-xl font-bold">Need detailed information?</h3>
        <p class="text-green-100 text-sm mt-1">Download our complete product catalog</p>
      </div>
      <BrochureButton label="Download Master Catalog" />
    </div>
  </section>
</Layout>
