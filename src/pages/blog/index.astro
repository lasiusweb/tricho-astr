---
import Layout from "../../layouts/Layout.astro";
import { posts } from "../../data/posts";
---

<Layout title="Learning Center — Vandhara Agrotech Blog | Organic Farming Tips">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <h1 class="text-3xl sm:text-4xl font-bold text-brand-green mb-4">Learning Center</h1>
    <p class="text-lg text-gray-600 mb-10">Insights, tips, and stories about organic farming, soil health, and sustainable agriculture.</p>

    {posts.length > 0 ? (
      <div class="space-y-6">
        {posts.map((post) => (
          <article class="bg-white rounded-xl border border-gray-100 p-6 shadow-sm hover:shadow-md transition-shadow">
            <a href={`/blog/${post.slug}`} class="block">
              <time class="text-xs text-gray-400">{post.date}</time>
              <h2 class="text-xl font-bold text-brand-green mt-1 hover:text-brand-green-light transition-colors">{post.title}</h2>
              <p class="text-gray-600 mt-2 text-sm leading-relaxed">{post.excerpt}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {post.tags.map((tag) => (
                  <span class="text-xs bg-green-50 text-brand-green px-2.5 py-1 rounded-full">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-gray-500 text-lg">Coming soon — we're writing helpful articles about organic farming and soil health.</p>
        <p class="text-gray-400 text-sm mt-2">Check back soon!</p>
      </div>
    )}
  </div>
</Layout>
