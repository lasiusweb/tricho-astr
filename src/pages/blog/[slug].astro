---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection("blog");
const related = allPosts.filter((p) => p.id !== post.id).slice(0, 2);
const pageUrl = `https://vandharaagrotech.com/blog/${post.id}`;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  author: { "@type": "Organization", name: post.data.author },
  publisher: {
    "@type": "Organization",
    name: "Vandhara Agrotech",
    logo: {
      "@type": "ImageObject",
      url: "https://vandharaagrotech.com/favicon.svg",
    },
  },
  keywords: post.data.tags.join(", "),
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  ...(post.data.image
    ? { image: new URL(post.data.image, "https://vandharaagrotech.com").href }
    : {}),
};
---

<Layout title={`${post.data.title} — Vandhara Agrotech Learning Center`} description={post.data.excerpt}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-16">
    <div class="mb-6">
      <a href="/blog" class="text-sm text-brand-green font-medium hover:text-brand-green-light transition-colors">&larr; Back to Learning Center</a>
    </div>

    {post.data.image && (
      <div class="rounded-xl overflow-hidden mb-8 shadow-md">
        <img src={post.data.image} alt={post.data.title} class="w-full aspect-[2/1] object-cover" />
      </div>
    )}

    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-3 text-sm text-gray-400">
        <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
        <span class="text-gray-300">|</span>
        <span>{post.data.readingTime}</span>
      </div>
      <h1 transition:name={`post-title-${post.id}`} class="text-3xl sm:text-4xl font-bold text-brand-green mt-2">{post.data.title}</h1>
      <div class="flex flex-wrap gap-2 mt-3">
        {post.data.tags.map((tag) => (
          <span class="text-xs bg-green-50 text-brand-green px-2.5 py-1 rounded-full">{tag}</span>
        ))}
      </div>
    </header>

    <div class="prose prose-green max-w-none">
      <Content />
    </div>

    <div class="mt-8 flex items-center gap-4 pt-6 border-t border-gray-100">
      <div class="w-10 h-10 rounded-full bg-brand-green flex items-center justify-center text-white font-bold text-sm shrink-0">
        {post.data.author.charAt(0)}
      </div>
      <div class="text-sm">
        <p class="font-semibold text-gray-800">Written by {post.data.author}</p>
        <p class="text-gray-500">Vandhara Agrotech</p>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <span class="text-sm text-gray-500 font-medium self-center">Share:</span>
      <a href={`https://wa.me/?text=${encodeURIComponent(post.data.title + " — " + pageUrl)}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-green-50 text-brand-green text-sm font-medium hover:bg-green-100 transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp
      </a>
      <button
        x-data
        @click="navigator.clipboard.writeText('${pageUrl}'); $el.textContent = 'Copied!'; setTimeout(() => $el.textContent = 'Copy Link', 2000)"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gray-100 text-gray-600 text-sm font-medium hover:bg-gray-200 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
        Copy Link
      </button>
    </div>

    {related.length > 0 && (
      <div class="mt-12 pt-8 border-t border-gray-200">
        <h2 class="text-xl font-bold text-brand-green mb-6">More Articles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {related.map((r) => (
            <a href={`/blog/${r.id}`} class="group bg-white rounded-xl border border-gray-100 p-5 shadow-sm hover:card-lift transition-all">
              <div class="flex items-center gap-2 text-xs text-gray-400 mb-2">
                <time datetime={r.data.date.toISOString()}>{fmt(r.data.date)}</time>
                <span class="text-gray-300">|</span>
                <span>{r.data.readingTime}</span>
              </div>
              <h3 class="font-bold text-brand-green group-hover:text-brand-green-light transition-colors">{r.data.title}</h3>
              <p class="text-sm text-gray-600 mt-1 leading-relaxed line-clamp-2">{r.data.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>
</Layout>
