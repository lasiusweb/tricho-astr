---
import type { ProductVariant } from "../data/products";

export interface Props {
  variants: ProductVariant[];
  productName: string;
}

const { variants, productName } = Astro.props;

const placeholderColors = [
  "from-brand-green to-green-600",
  "from-brand-gold to-amber-600",
  "from-green-700 to-green-900",
];
---

<section class="mb-10">
  <h2 class="text-2xl font-bold text-brand-green mb-4">Available Pack Sizes</h2>
  <div x-data={`{ selected: '${variants[0].size}' }`}>
    <div class="flex gap-2 mb-6">
      {variants.map((v) => (
        <button
          @click={`selected = '${v.size}'`}
          class="px-5 py-2.5 rounded-lg text-sm font-semibold border-2 transition-all"
          :class={`selected === '${v.size}' ? 'bg-brand-green text-white border-brand-green shadow-md' : 'bg-white text-gray-600 border-gray-200 hover:border-brand-green hover:text-brand-green'`}
        >
          {v.label}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {variants.map((v, i) => (
        <div
          x-show={`selected === '${v.size}'`}
          x-cloak
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
        >
          <div class={`rounded-xl bg-gradient-to-br ${placeholderColors[i % placeholderColors.length]} p-8 flex flex-col items-center justify-center min-h-[280px] shadow-md`}>
            <svg class="w-20 h-20 text-white/80 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            <p class="text-white font-bold text-lg">{productName}</p>
            <p class="text-white/80 text-sm mt-1">{v.label}</p>
            <p class="text-white/60 text-xs mt-3">Placeholder — replace with product image</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
