---

<div class="bg-brand-green-dark text-green-200 text-sm border-t border-green-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <span class="font-medium text-white/90">Trusted by farmers across India</span>
      <div class="flex items-center gap-6 text-xs">
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-brand-green-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> FCO Certified</span>
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-brand-green-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> NPOP Certified</span>
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-brand-green-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg> Made in India</span>
      </div>
    </div>
  </div>

<footer class="bg-brand-green text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <a href="/" class="text-xl font-bold">
          <span class="text-brand-gold">Vandhara</span> Agrotech
        </a>
        <p class="mt-3 text-sm text-green-200 leading-relaxed">
          Restoring India's soil health through eco-friendly, scientifically developed fermented organic liquids.
        </p>
        <div class="mt-5 flex items-center gap-3">
          {socialLinks.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 flex items-center justify-center rounded-full bg-green-700/50 text-green-200 hover:bg-brand-gold hover:text-white transition-all"
              aria-label={s.label}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" set:html={s.svg} />
            </a>
          ))}
        </div>
      </div>
      <div>
        <h3 class="font-semibold text-brand-gold-light mb-4">Quick Links</h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-green-200 hover:text-brand-gold-light transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="font-semibold text-brand-gold-light mb-4">Products</h3>
        <ul class="space-y-2">
          {productLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-green-200 hover:text-brand-gold-light transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="font-semibold text-brand-gold-light mb-4">Contact</h3>
        <ul class="space-y-2 text-sm text-green-200">
          <li>
            <a href="mailto:vandharaagrotech@gmail.com" class="hover:text-brand-gold-light transition-colors">vandharaagrotech@gmail.com</a>
          </li>
          <li>
            <a href="tel:+916359299124" class="hover:text-brand-gold-light transition-colors">+91 63592 99124</a>
          </li>
          <li class="leading-relaxed">
            First Floor, Shop No-4, Real Plaza -2,<br />
            8A National Highway, Lalpar,<br />
            Morbi, Gujarat - 363642
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-8 pt-8 border-t border-green-700 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-green-300">
      <p>&copy; {new Date().getFullYear()} Vandhara Agrotech. Manufactured and Marketed by Lasius International.</p>
      <div class="flex items-center gap-4">
        <a href="/legal/privacy" class="hover:text-brand-gold-light transition-colors">Privacy Policy</a>
        <span class="text-green-600">|</span>
        <a href="/legal/terms" class="hover:text-brand-gold-light transition-colors">Terms &amp; Conditions</a>
        <span class="text-green-600">|</span>
        <a href="/legal/refund" class="hover:text-brand-gold-light transition-colors">Refund Policy</a>
      </div>
    </div>
  </div>
</footer>
