---
import { getProducts } from "../data/products";

const productList = await getProducts();
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About Us" },

  { href: "/blog", label: "Learning Center" },
  { href: "/partner", label: "Partner with Us" },
  { href: "/contact", label: "Contact" },
];
function isActive(href: string) {
  if (href === "/") return currentPath === "/" || currentPath === "/index.html";
  return currentPath.startsWith(href);
}
---

<!-- Top contact bar -->
<div class="hidden lg:block bg-brand-green-dark text-green-200 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-end h-9 gap-6">
    <a href="tel:+916359299124" class="flex items-center gap-1.5 hover:text-white transition-colors">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
      +91 63592 99124
    </a>
    <a href="mailto:vandharaagrotech@gmail.com" class="flex items-center gap-1.5 hover:text-white transition-colors">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
      vandharaagrotech@gmail.com
    </a>
  </div>
</div>

<nav
  class="sticky top-0 z-50 transition-shadow duration-300"
  x-data="{ open: false, productsOpen: false, menuTimer: null, scrolled: false }"
  x-init="scrolled = window.scrollY > 10"
  @scroll.window="scrolled = window.scrollY > 10"
  :class="scrolled ? 'shadow-md' : ''"
  aria-label="Primary navigation"
>
  <div class="glass-strong">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-1 font-bold text-xl shrink-0">
          <span class="text-brand-green">Vandhara</span>
          <span class="text-gray-400 font-normal hidden xs:inline">Agrotech</span>
        </a>

        <div class="hidden lg:flex items-center gap-0.5">
          {links.map((link) => (
            <a
              href={link.href}
              class="nav-link px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-brand-green transition-colors"
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}

          <div
            class="relative"
            @mouseenter="clearTimeout(menuTimer); menuTimer = setTimeout(() => productsOpen = true, 50)"
            @mouseleave="menuTimer = setTimeout(() => productsOpen = false, 200)"
          >
            <button
              id="products-button"
              class="flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-brand-green transition-colors"
              :class="productsOpen ? 'text-brand-green' : ''"
              aria-haspopup="menu"
              aria-expanded="false" :aria-expanded="productsOpen ? 'true' : 'false'"
              aria-controls="products-menu"
              @click="productsOpen = !productsOpen"
              @keydown.enter.prevent="productsOpen = !productsOpen"
              @keydown.space.prevent="productsOpen = !productsOpen"
            >
              Products
              <svg class="w-3.5 h-3.5 transition-transform" :class="productsOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div
              id="products-menu"
              x-show="productsOpen"
              x-cloak
              role="menu"
              aria-labelledby="products-button"
              class="absolute right-0 mt-2 w-[500px] bg-white rounded-xl shadow-xl border border-gray-100 p-5"
              @click="productsOpen = false"
              @keydown.escape.window="productsOpen = false"
            >
              <div class="grid grid-cols-2 gap-4">
                {productList.map((p) => (
                  <a
                    href={`/products/${p.slug}`}
                    role="menuitem"
                    class="group block p-4 rounded-lg hover:bg-green-50 transition-colors"
                  >
                    <h3 class="font-bold text-brand-green group-hover:text-brand-green-light transition-colors">{p.name}</h3>
                    <p class="text-xs text-brand-gold mt-0.5">{p.tagline}</p>
                    <p class="text-xs text-gray-500 mt-1 leading-relaxed line-clamp-2">{p.description}</p>
                    <p class="text-xs text-gray-400 mt-2">{p.benefit}</p>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a href="/contact" class="ml-2 px-4 py-2 rounded-lg btn-cta text-sm">Get a Quote</a>
        </div>

        <div class="lg:hidden flex items-center gap-1">
          <a href="tel:+916359299124" class="p-2 rounded-lg text-gray-600 hover:text-brand-green transition-colors" aria-label="Call us">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          </a>
          <button
            class="p-2 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors"
            @click="open = !open"
            @keydown.enter.prevent="open = !open"
            @keydown.space.prevent="open = !open"
            aria-label="Toggle menu"
            aria-controls="mobile-menu"
            aria-expanded="false" :aria-expanded="open ? 'true' : 'false'"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path x-show="!open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              <path x-show="open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-0 z-40"
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
  >
    <div class="fixed inset-0 bg-black/40" @click="open = false" />
    <div
      class="fixed right-0 top-16 w-80 max-w-[85vw] bottom-0 bg-white shadow-2xl overflow-y-auto"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="translate-x-full"
    >
      <div class="px-3 pt-4 pb-8">
      <div class="border-b border-gray-100 pb-3 mb-3">
        <a href="tel:+916359299124" class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-brand-green transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          +91 63592 99124
        </a>
        <a href="mailto:vandharaagrotech@gmail.com" class="flex items-center gap-2 px-3 py-2 text-sm text-gray-600 hover:text-brand-green transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          vandharaagrotech@gmail.com
        </a>
      </div>
      {links.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2.5 rounded-lg text-sm font-medium text-gray-700 hover:text-brand-green hover:bg-green-50 transition-colors"
          @click="open = false"
        >
          {link.label}
        </a>
      ))}

      <div x-data="{ subOpen: false }">
        <button
          class="flex items-center justify-between w-full px-3 py-2.5 rounded-lg text-sm font-medium text-gray-700 hover:text-brand-green hover:bg-green-50 transition-colors"
          @click="subOpen = !subOpen"
        >
          Products
          <svg class="w-3.5 h-3.5 transition-transform" :class="subOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div x-show="subOpen" x-cloak class="ml-3 mt-1 space-y-1">
          {productList.map((p) => (
            <a
              href={`/products/${p.slug}`}
              class="block px-3 py-2.5 rounded-lg text-sm text-gray-600 hover:text-brand-green hover:bg-green-50 transition-colors"
              @click="open = false"
            >
              {p.name} <span class="text-xs text-gray-400">&mdash; {p.tagline}</span>
            </a>
          ))}
        </div>
      </div>

      <a href="/contact" class="block px-3 py-2.5 rounded-lg text-sm text-center mt-3 btn-cta" @click="open = false">Get a Quote</a>
    </div>
    </div>
  </div>
</nav>
