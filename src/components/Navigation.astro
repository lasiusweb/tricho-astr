---
import { productList } from "../data/products";

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About Us" },
  { href: "/sustainability", label: "Sustainability" },
  { href: "/testimonials", label: "Testimonials" },
  { href: "/blog", label: "Learning Center" },
  { href: "/partner", label: "Partner with Us" },
  { href: "/contact", label: "Contact" },
];
---

<nav class="bg-brand-green text-white sticky top-0 z-50 shadow-lg" x-data="{ open: false, productsOpen: false }" aria-label="Primary navigation">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 font-bold text-xl tracking-tight shrink-0">
        <span class="text-white">Vandhara</span>
        <span class="hidden xs:inline">Agrotech</span>
      </a>

      <div class="hidden lg:flex items-center gap-1">
        {links.map((link) => (
          <a
            href={link.href}
            class="px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-green-700/60 hover:text-brand-gold-light"
          >
            {link.label}
          </a>
        ))}

        <div
          class="relative"
          @mouseenter="productsOpen = true"
          @mouseleave="productsOpen = false"
        >
          <button
            id="products-button"
            class="flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors hover:bg-green-700/60 hover:text-brand-gold-light"
            :class="productsOpen ? 'bg-green-700/60 text-brand-gold-light' : ''"
            aria-haspopup="menu"
            :aria-expanded="productsOpen ? 'true' : 'false'"
            aria-controls="products-menu"
            @click="productsOpen = !productsOpen"
            @keydown.enter.prevent="productsOpen = !productsOpen"
            @keydown.space.prevent="productsOpen = !productsOpen"
          >
            Products
            <svg class="w-3.5 h-3.5 transition-transform" :class="productsOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div
            id="products-menu"
            x-show="productsOpen"
            x-cloak
            role="menu"
            aria-labelledby="products-button"
            class="absolute right-0 mt-2 w-[500px] bg-white rounded-xl shadow-xl border border-gray-100 p-5"
            @click="productsOpen = false"
            @keydown.escape.window="productsOpen = false"
          >
            <div class="grid grid-cols-2 gap-4">
              {productList.map((p) => (
                <a
                  href={`/products/${p.slug}`}
                  role="menuitem"
                  class="group block p-4 rounded-lg hover:bg-green-50 transition-colors"
                >
                  <h3 class="font-bold text-brand-green group-hover:text-brand-green-light transition-colors">{p.name}</h3>
                  <p class="text-xs text-brand-gold mt-0.5">{p.tagline}</p>
                  <p class="text-xs text-gray-500 mt-1 leading-relaxed line-clamp-2">{p.description}</p>
                  <p class="text-xs text-gray-400 mt-2">Pack sizes: {p.variants.map((v) => v.label).join(" / ")}</p>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a
          href="/contact"
          class="ml-2 px-4 py-2 rounded-lg bg-brand-gold text-white font-semibold text-sm hover:bg-amber-600 transition-colors"
        >
          Get a Quote
        </a>
      </div>

      <button
        class="lg:hidden p-2 rounded-lg hover:bg-green-700/60 transition-colors"
        @click="open = !open"
        @keydown.enter.prevent="open = !open"
        @keydown.space.prevent="open = !open"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        :aria-expanded="open ? 'true' : 'false'"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path x-show="!open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path x-show="open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden" x-show="open" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 -translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
    <div class="px-2 pt-2 pb-4 bg-brand-green border-t border-green-700">
      {links.map((link) => (
        <a
          href={link.href}
          class="block px-3 py-2 rounded-lg text-sm font-medium hover:bg-green-700/60 hover:text-brand-gold-light transition-colors"
          @click="open = false"
        >
          {link.label}
        </a>
      ))}

      <div x-data="{ subOpen: false }">
        <button
          class="flex items-center justify-between w-full px-3 py-2 rounded-lg text-sm font-medium hover:bg-green-700/60 hover:text-brand-gold-light transition-colors"
          @click="subOpen = !subOpen"
        >
          Products
          <svg class="w-3.5 h-3.5 transition-transform" :class="subOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div x-show="subOpen" x-cloak class="ml-3 mt-1 space-y-1">
          {productList.map((p) => (
            <a
              href={`/products/${p.slug}`}
              class="block px-3 py-2 rounded-lg text-sm text-green-200 hover:bg-green-700/60 hover:text-brand-gold-light transition-colors"
              @click="open = false"
            >
              {p.name} &mdash; <span class="text-xs">{p.tagline}</span>
            </a>
          ))}
        </div>
      </div>

      <a
        href="/contact"
        class="block px-3 py-2 rounded-lg bg-brand-gold text-white font-semibold text-sm text-center mt-2 hover:bg-amber-600 transition-colors"
        @click="open = false"
      >
        Get a Quote
      </a>
    </div>
  </div>
</nav>
