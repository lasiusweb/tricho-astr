---
export interface Props {
  farmerContent: string;
  dealerContent: string;
}

const { farmerContent, dealerContent } = Astro.props;
---

<div x-data="{ tab: 'farmer' }" class="mb-8">
  <div class="flex gap-1 bg-gray-100 rounded-lg p-1 w-fit mb-6">
    <button
      class="px-4 py-2 rounded-md text-sm font-medium transition-colors"
      :class="tab === 'farmer' ? 'bg-brand-green text-white shadow-sm' : 'text-gray-600 hover:text-gray-900'"
      @click="tab = 'farmer'"
    >
      I'm a Farmer
    </button>
    <button
      class="px-4 py-2 rounded-md text-sm font-medium transition-colors"
      :class="tab === 'dealer' ? 'bg-brand-green text-white shadow-sm' : 'text-gray-600 hover:text-gray-900'"
      @click="tab = 'dealer'"
    >
      I'm a Dealer / Distributor
    </button>
  </div>
  <div x-show="tab === 'farmer'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100">
    <slot name="farmer" />
  </div>
  <div x-show="tab === 'dealer'" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100">
    <slot name="dealer" />
  </div>
</div>
